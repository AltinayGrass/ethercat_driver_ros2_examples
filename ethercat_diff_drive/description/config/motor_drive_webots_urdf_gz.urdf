  <ros2_control name="motor_drive" type="system">
    <hardware>
      <!-- <plugin>webots_ros2_control::Ros2ControlSystem</plugin> -->
      <plugin>ethercat_driver/EthercatDriver</plugin>
      <param name="master_id">0</param>
      <param name="control_frequency">100</param>
    </hardware>
    <joint name="wheel_left_joint">
<!--       <state_interface name="position"/>
      <state_interface name="velocity"/>
      <command_interface name="velocity"/> -->
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <command_interface name="velocity"/>
      <command_interface name="reset_fault"/>
      <ec_module name="Maxon">
        <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
        <param name="alias">0</param>
        <param name="position">0</param>
        <param name="mode_of_operation">9</param>
        <param name="slave_config">$(find ethercat_diff_drive)/config/maxon_epos4_config.yaml</param>
      </ec_module>
    </joint>
    <joint name="wheel_right_joint">
      <!-- <state_interface name="position"/>
      <state_interface name="velocity"/>
      <command_interface name="velocity"/> -->
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <command_interface name="velocity"/>
      <command_interface name="reset_fault"/>
      <ec_module name="Maxon">
        <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
        <param name="alias">0</param>
        <param name="position">1</param>
        <param name="mode_of_operation">9</param>
        <param name="slave_config">$(find ethercat_diff_drive)/config/maxon_epos4_config.yaml</param>
      </ec_module>
    </joint>
    <joint name="caster_front_right_1_joint">
      <state_interface name="position"/>
    </joint>
    <joint name="caster_front_left_1_joint">
      <state_interface name="position"/>
    </joint>
    <joint name="caster_back_right_1_joint">
      <state_interface name="position"/>
    </joint>
    <joint name="caster_back_left_1_joint">
      <state_interface name="position"/>
    </joint>
    <joint name="caster_front_right_2_joint">
      <state_interface name="position"/>
    </joint>
    <joint name="caster_front_left_2_joint">
      <state_interface name="position"/>
    </joint>
    <joint name="caster_back_right_2_joint">
      <state_interface name="position"/>
    </joint>
    <joint name="caster_back_left_2_joint">
      <state_interface name="position"/>
    </joint>
  </ros2_control>
</robot>
