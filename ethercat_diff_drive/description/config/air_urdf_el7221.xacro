<?xml version="1.0"?>
<robot name="air" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>

  <material name="red">
    <color rgba="0.8 0 0 1"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <material name="yellow">
    <color rgba="1.0 0.92 0.016 1"/>
  </material>

  <material name="grey">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>


    <!-- Define some commonly used intertial properties  -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0" iyy="${(m/12) * (w*w + d*d)}" iyz="0.0" izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy = "0" ixz = "0" iyy="${(m/12) * (3*r*r + h*h)}" iyz = "0" izz="${(m/2) * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${(2/5) * m * (r*r)}" ixy="0.0" ixz="0.0" iyy="${(2/5) * m * (r*r)}" iyz="0.0" izz="${(2/5) * m * (r*r)}"/>
    </inertial>
  </xacro:macro>

  <!-- Define robot constants -->
  <xacro:property name="base_width" value="0.5"/>
  <xacro:property name="base_length" value="0.66"/>
  <xacro:property name="base_height" value="0.2"/>
  <xacro:property name="base_tick" value="0.01"/>
  <xacro:property name="base_panel_length" value="0.22"/>
  <xacro:property name="base_panel_width" value="0.38"/>

  <xacro:property name="battery_width" value="0.12"/>
  <xacro:property name="battery_length" value="0.62"/>
  <xacro:property name="battery_height" value="0.18"/>

  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_ygap" value="-0.035"/>
  <xacro:property name="wheel_zoff" value="0.05"/>
  <xacro:property name="wheel_xoff" value="0.0"/>

  <xacro:property name="caster_xoff" value="0.27"/>
  <xacro:property name="caster_yoff" value="0.15"/>


<!-- Robot Base -->
  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 ${wheel_zoff}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_panel_length} ${base_panel_width} ${base_tick}"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <visual>
      <origin xyz="${(-1.0*base_panel_length)} 0.0 ${wheel_zoff}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_panel_length} ${base_width} ${base_tick}"/>
      </geometry>
       <material name="grey"/>
    </visual>

    <visual>
      <origin xyz="${(base_panel_length)} 0.0 ${wheel_zoff}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_panel_length} ${base_width} ${base_tick}"/>
      </geometry>
       <material name="grey"/>
    </visual>

    <visual>
      <origin xyz="0.0 0.0 ${wheel_zoff+base_height}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_panel_length} ${base_panel_width} ${base_tick}"/>
      </geometry>
       <material name="grey"/>
    </visual>

    <visual>
      <origin xyz="${(-1.0*base_panel_length)} 0.0 ${wheel_zoff+base_height}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_panel_length} ${base_width} ${base_tick}"/>
      </geometry>
       <material name="grey"/>
    </visual>

    <visual>
      <origin xyz="${(base_panel_length)} 0.0 ${wheel_zoff+base_height}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_panel_length} ${base_width} ${base_tick}"/>
      </geometry>
       <material name="grey"/>
    </visual>

    <collision>
      <origin xyz="0.0 0.0 ${(base_height/2+wheel_zoff)}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia m="15" w="${base_width}" d="${base_length}" h="${base_height}"/>
  </link>

<!-- Robot battery -->
  <link name="battery_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="${battery_length} ${battery_width} ${battery_height}"/>
      </geometry>
      <material name="blue"/>
  
    </visual>
      <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="${battery_length} ${battery_width} ${battery_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia m="16" w="${battery_width}" d="${battery_length}" h="${battery_height}"/>
  </link>

  <joint name="battery_joint" type="fixed">
    <parent link="base_link"/>
    <child link="battery_link"/>
    <origin xyz="0.0 0.0 ${wheel_zoff+base_height+battery_height/2.0}" rpy="0 0 0"/>
  </joint>

  <!-- Wheels -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="joint_link_${prefix}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="red"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="joint_${prefix}" type="continuous">
      <parent link="base_link"/>
      <child link="joint_link_${prefix}"/>
      <origin xyz="${x_reflect*wheel_xoff} ${y_reflect*(base_width/2+wheel_ygap)} ${wheel_radius}" rpy="${y_reflect*pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="10" friction="5"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="1" x_reflect="-1" y_reflect="1" />
  <xacro:wheel prefix="2" x_reflect="-1" y_reflect="-1" />

  <link name="front_left_caster">
    <visual>
      <geometry>
        <sphere radius="${(wheel_zoff/2)}"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${(wheel_zoff/2)}"/>
      </geometry>
    </collision>

    <xacro:sphere_inertia m="0.5" r="${(base_height/2+wheel_zoff)}"/>
  </link>

  <joint name="front_left_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_caster"/>
    <origin xyz="${caster_xoff} ${caster_yoff} ${(wheel_zoff/2)}" rpy="0 0 0"/>
  </joint>

  <link name="front_right_caster">
    <visual>
      <geometry>
        <sphere radius="${(wheel_zoff/2)}"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${(wheel_zoff/2)}"/>
      </geometry>
    </collision>

    <xacro:sphere_inertia m="0.5" r="${(base_height/2+wheel_zoff)}"/>
  </link>

  <joint name="front_right_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_caster"/>
    <origin xyz="${caster_xoff} ${-1.0*caster_yoff} ${(wheel_zoff/2)}" rpy="0 0 0"/>
  </joint>

  <link name="rear_left_caster">
    <visual>
      <geometry>
        <sphere radius="${(wheel_zoff/2)}"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${(wheel_zoff/2)}"/>
      </geometry>
    </collision>

    <xacro:sphere_inertia m="0.5" r="${(base_height/2+wheel_zoff)}"/>
  </link>

  <joint name="rear_left_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_caster"/>
    <origin xyz="${-1.0*caster_xoff} ${caster_yoff} ${(wheel_zoff/2)}" rpy="0 0 0"/>
  </joint>

  <link name="rear_right_caster">
    <visual>
      <geometry>
        <sphere radius="${(wheel_zoff/2)}"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${(wheel_zoff/2)}"/>
      </geometry>
    </collision>

    <xacro:sphere_inertia m="0.5" r="${(base_height/2+wheel_zoff)}"/>
  </link>

  <joint name="rear_right_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_caster"/>
    <origin xyz="${-1.0*caster_xoff} ${-1.0*caster_yoff} ${(wheel_zoff/2)}" rpy="0 0 0"/>
  </joint>

  <!-- ****************************** LASER 0 *****************************    -->
  <link name="laser_link_0">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.125"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>   
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0508" length="0.18"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="3.1415 0 -1.5708"/>
      <geometry>
        <!-- <cylinder radius="0.0508" length="0.055"/> -->
        <mesh filename="package://ethercat_diff_drive/description/config/meshes/s300.obj" scale="0.001 0.001 0.001"/>
      </geometry>
        <material name="yellow"/>
      <!-- <material name="lidar_visual">
        <color rgba="0.8 0 0 1"/>
        <ambient>0.0 0.0 0.0 1.0</ambient>
        <diffuse>0.0 0.0 0.0 1.0</diffuse>
        <specular>0.0 0.0 0.0 1.0</specular>
        <emissive>0.0 0.0 0.0 1.0</emissive>
      </material> -->
    </visual>
  </link>
  
  <joint name="laser_joint_0" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link_0"/>
    <origin xyz="0.4 -0.28 0.18" rpy="0 0 -0.7854"/>
  </joint>

    <!-- ****************************** LASER 1 *****************************    -->
  <link name="laser_link_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.125"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>   
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0508" length="0.18"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="3.1415 0 -1.5708"/>
      <geometry>
        <!-- <cylinder radius="0.0508" length="0.055"/> -->
        <mesh filename="package://ethercat_diff_drive/description/config/meshes/s300.obj" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="yellow"/>
      <!-- <material name="lidar_visual">
        <color rgba="0.8 0 0 1"/>
        <ambient>0.0 0.0 0.0 1.0</ambient>
        <diffuse>0.0 0.0 0.0 1.0</diffuse>
        <specular>0.0 0.0 0.0 1.0</specular>
        <emissive>0.0 0.0 0.0 1.0</emissive>
      </material> -->
    </visual>
  </link>
  
  <joint name="laser_joint_1" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link_1"/>
    <origin xyz="-0.4 0.28 0.18" rpy="0 0 2.3562"/>
  </joint>
  
  <!-- RealSense D435i Camera -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.09 0.025"/> <!-- Temsili kutu -->
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0"
               izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.25 0.0 0.50" rpy="0 0 0"/>
  </joint>
   
  <xacro:include filename="$(find ethercat_diff_drive)/description/ros2_control/motor_drive_el7221.xacro" />
  <xacro:motor_drive/>
</robot>
